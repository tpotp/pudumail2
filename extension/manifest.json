{
  "manifest_version": 3,
  "name": "Pudú Mail - Conector de Adjuntos de Gmail",
  "version": "2.0.0",
  "description": "Conector oficial y privado para explorar, ordenar por tamaño y respaldar adjuntos de Gmail en Pudú Mail 2.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "downloads",
    "storage",
    "identity"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [

    {
      "matches": [
        "https://pudumail2.vercel.app/*",
        "https://*.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["web_bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pudú Mail Conector",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "externally_connectable": {
    "matches": [
      "https://pudumail2.vercel.app/*",
      "https://*.vercel.app/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "oauth2": {
    "client_id": "329468340708-1pejmiuiecpret2er3t5otop6gf06p3b.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly",
      "https://www.googleapis.com/auth/gmail.modify"
    ]
  }
}
